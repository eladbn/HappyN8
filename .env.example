# Copy to .env and fill in, then: docker compose up -d --build

# n8n address as seen from inside the HappyN8 container. Optional: admins can also set
# or change the IP/host and port in the app (Manage -> n8n connection), which overrides this.
N8N_URL=http://your-n8n-host:5678
# Address your browser uses for "Open in n8n" links (defaults to N8N_URL).
# N8N_PUBLIC_URL=http://your-n8n-host:5678

# n8n -> Settings -> n8n API -> Create an API key
N8N_API_KEY=

# Optional but recommended: an n8n user login. Unlocks the full module catalog with
# logos and forms, dynamic dropdowns (channels, sheets...), and "Run once" / "Test step".
N8N_EMAIL=
N8N_PASSWORD=

# HappyN8 has its own users (Admin -> Users). On the very first start, an admin account
# is created with this username and password. Change the password after signing in.
ADMIN_USERNAME=admin
APP_PASSWORD=
# Long random string that signs sessions (keeps you signed in across restarts).
# Generate one with: openssl rand -hex 32
SESSION_SECRET=

# Port HappyN8 is published on, on the server (http://your-server:FLOWBOARD_PORT).
FLOWBOARD_PORT=45310
# Port the app listens on inside the container. Only change it if 8080 clashes with
# something (e.g. when running with network_mode: host or without Docker).
# PORT=8080
# Set to true if you put HappyN8 behind HTTPS.
COOKIE_SECURE=false

# How long the activity log is kept (days).
AUDIT_RETENTION_DAYS=730
